# ─────────────────────────────────────────────
# Easy ERP 환경변수 예시
# 1) 이 파일을 복사해서 `.env.local` 을 만드세요.  (cp .env.example .env.local)
# 2) Supabase 대시보드 > Project Settings > API 에서 값을 복사해 넣으세요.
# 3) `.env.local` 은 .gitignore 에 의해 절대 커밋되지 않습니다.
# ─────────────────────────────────────────────

# Supabase 프로젝트 주소 (브라우저에 노출되어도 되는 값)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable(공개) 키 — 예전 이름은 "anon key"
# 브라우저에 노출되어도 되며, 실제 데이터 보호는 RLS 정책이 담당합니다.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# ⚠️ Secret 키(service_role)는 MVP에서 사용하지 않습니다.
#    RLS를 우회하는 관리자 키이므로, 필요해지면 별도 승인 후 서버 전용으로만 추가합니다.
#    절대 NEXT_PUBLIC_ 접두사를 붙이지 마세요.
# SUPABASE_SECRET_KEY=
