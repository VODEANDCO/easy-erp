# ─────────────────────────────────────────────
# Easy ERP 환경변수 예시 (실제 값은 절대 넣지 마세요)
# 1) 이 파일을 복사해 `.env.local` 을 만듭니다.  (cp .env.example .env.local)
# 2) Supabase 대시보드 > Project Settings > API Keys 에서 값을 복사합니다.
# 3) `.env.local` 은 .gitignore 에 의해 커밋되지 않습니다.
# 4) Vercel 배포 시에는 Vercel 프로젝트 설정 > Environment Variables 에 따로 등록합니다.
# ─────────────────────────────────────────────

# Supabase 프로젝트 주소 — 브라우저에 노출되어도 되는 값
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable(공개) 키 — 예전 이름 "anon key"
# 브라우저에서는 "서버가 발급한 이미지 업로드 URL"로 업로드할 때만 사용합니다.
# 이 키로는 products 테이블에 접근할 수 없도록 DB 권한을 막아둡니다.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# ⚠️ Secret 키 — 서버 전용. 상품 조회/등록/수정/삭제는 Next.js 서버가 이 키로 처리합니다.
#    절대 NEXT_PUBLIC_ 을 붙이지 말고, 채팅·스크린샷·GitHub 에 노출하지 마세요.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# 공개 데모 모드 — 서버 전용 (NEXT_PUBLIC_ 을 붙이지 마세요)
# - 정확히 true 일 때만 로그인 없이 상품 조회·등록·수정·삭제를 허용합니다. (이번 미션: 상품 CRUD)
# - 값이 없거나 true 가 아니면("TRUE", "1" 포함) 상품 화면은 차단됩니다. (기본값 = 차단)
# - 누구나 데이터를 보고 바꿀 수 있으므로 테스트 데이터만 사용합니다.
# - 악용이 의심되면 값을 지우거나 false 로 바꾸고 다시 배포하면 즉시 차단됩니다.
PRODUCTS_DEMO_MODE=false

# ── (선택 작업 · 보류) 요청 횟수 제한 — 도입이 승인되면 사용 ──
# true 로 켜면 SALT 가 반드시 필요하며, 제한 확인에 실패하면 쓰기 요청을 거부합니다(fail-closed).
# RATE_LIMIT_ENABLED=false
# ⚠️ 서버 전용. 32자 이상 무작위 문자열
# RATE_LIMIT_SALT=
